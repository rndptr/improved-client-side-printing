<Curves>
 <namedParam name="hue_map">
  <curve wrap="wrap" type="linear" gamma="0" piecewise="false">
   <sequence count="48" lower-bound="-6" upper-bound="6">
	0	0	0	-0.02	-0.04	-0.08	-0.12	-0.16
	-0.2	-0.24	-0.28	-0.32	-0.32	-0.32	-0.32	-0.32
